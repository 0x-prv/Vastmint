# Pinata server-side upload credentials
# Use a restricted JWT when possible. Never expose Pinata API secrets to the browser.
PINATA_JWT=

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Required public contract addresses for the active Ritual testnet deployment
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=

# Optional legacy NFT address override, if needed by tooling
NEXT_PUBLIC_NFT_ADDRESS=

# Optional RPC override for Hardhat deployment
RITUAL_RPC_URL=https://rpc.ritualfoundation.org

# Hardhat deployment
PRIVATE_KEY=
